    "@types/d3": "^7.4.3",
    "@types/d3-delaunay": "^6.0.4",
    "@types/jsdom": "^28.0.3",
    "jsdom": "^29.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  }
